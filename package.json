{
  "name": "mc_gacha_tool",
  "version": "1.1.0",
  "description": "这是一个鸣潮抽卡分析工具，写着玩的",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cross-env NODE_ENV=development nodemon --exec electron . --watch electron --watch main.js",
    "start": "electron .",
    "build:frontend": "cd frontend && npm run build && node ../scripts/copyDist.js",
    "build": "npm run build:frontend && npm run build-w",
    "rebuild": "electron-rebuild",
    "re-sqlite": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint electron/**/*.js --ignore-path .eslintignore",
    "lint:fix": "eslint electron/**/*.js --ignore-path .eslintignore --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "build-w": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=nsis --x64",
    "build-w-32": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=nsis --ia32",
    "build-w-64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=nsis --x64",
    "build-w-arm64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=nsis --arm64",
    "build-we": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=portable --x64",
    "build-wz": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=7z --x64",
    "build-wz-32": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=7z --ia32",
    "build-wz-64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=7z --x64",
    "build-wz-arm64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -w=7z --arm64",
    "build-m": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -m",
    "build-m-arm64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -m --arm64",
    "build-l": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=deb --x64",
    "build-l-32": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=deb --ia32",
    "build-l-64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=deb --x64",
    "build-l-arm64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=deb --arm64",
    "build-l-armv7l": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=deb --armv7l",
    "build-lr-64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=rpm --x64",
    "build-lp-64": "npm run build:frontend && electron-builder --config=./electron/config/builder.json -l=pacman --x64",
    "test": "cross-env DEBUG=* NODE_ENV=local electron ."
  },
  "keywords": [
    "Electron"
  ],
  "author": "ChangDh, <1392238525@qq.com>",
  "license": "Apache",
  "devDependencies": {
    "@electron/rebuild": "^3.2.13",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "debug": "^4.3.3",
    "electron": "^21.4.4",
    "electron-builder": "^23.6.0",
    "eslint": "^5.13.0",
    "eslint-plugin-prettier": "^3.0.1",
    "icon-gen": "^5.0.0",
    "nodemon": "^2.0.16",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.81.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "electron-updater": "^5.3.0",
    "fs-extra": "^11.4.1",
    "get-installed-apps": "^1.1.0",
    "lodash": "^4.17.21",
    "node-xlsx": "^0.24.0"
  }
}
